**/.pc/

# Python caches and test output
**/__pycache__/
*.py[cod]
.coverage
.pytest_cache/
htmlcov/

# Local environments and editor files
.venv/
.idea/
.vscode/
*.swp
*.swo
*~

# secrets
*.key
